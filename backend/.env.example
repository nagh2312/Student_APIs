# Application
APP_NAME=Student API Platform
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
MOCK_MODE=true
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database
DATABASE_URL=postgresql+asyncpg://studentapi:studentapi@localhost:5432/studentapi

# Redis
REDIS_URL=redis://localhost:6379/0

# Rate limiting
RATE_LIMIT_ANONYMOUS=60
RATE_LIMIT_AUTHENTICATED=300
RATE_LIMIT_WINDOW_SECONDS=60

# Cache TTLs (seconds)
CACHE_TTL_WEATHER=600
CACHE_TTL_CURRENCY=3600
CACHE_TTL_GEOGRAPHY=86400
CACHE_TTL_BOOKS=3600

# Providers (live mode)
WEATHER_PROVIDER=openmeteo
WEATHER_API_KEY=
GEOGRAPHY_PROVIDER=nominatim
BOOKS_PROVIDER=openlibrary
CURRENCY_PROVIDER=frankfurter

# Security
API_KEY_PEPPER=change-me-in-production
SECRET_KEY=change-me-in-production-use-openssl-rand
